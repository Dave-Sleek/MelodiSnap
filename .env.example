# AudD API Token (Required for song recognition)
AUDD_API_TOKEN="your_audd_api_token"

# Spotify API (Required for Spotify integration)
VITE_SPOTIFY_CLIENT_ID="your_spotify_client_id"

# Apple Music API (Required for Apple Music integration)
APPLE_TEAM_ID="your_apple_team_id"
APPLE_KEY_ID="your_apple_key_id"
APPLE_PRIVATE_KEY="your_apple_private_key_multiline_escaped"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
